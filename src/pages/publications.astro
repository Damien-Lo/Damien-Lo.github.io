---
import Base from "../layouts/Base.astro";
import PubEntry from "../components/PubEntry.astro";
import { publications } from "../data/publications";

const papers = publications.filter((p) => p.status !== "thesis");
const theses = publications.filter((p) => p.status === "thesis");
---

<Base title="Publications" description="Papers and thesis by Damien Lo.">
  <div class="wrap">
    <h1 class="page-title">Publications</h1>
    <h2>Papers</h2>
    {papers.map((p) => <PubEntry pub={p} />)}
    <h2>Thesis</h2>
    {theses.map((p) => <PubEntry pub={p} />)}
  </div>
</Base>

<style>
  .page-title { margin-top: 2.5rem; }
  h2 { font-size: 0.8rem; font-family: var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); margin: 2rem 0 0; }
</style>
