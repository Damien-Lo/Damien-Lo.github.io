---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
---

<Base title="CV" description="Curriculum vitae of Damien Lo.">
  <div class="wrap">
    <h1 class="page-title">CV</h1>
    <p class="row">
      <a class="btn" href={profile.links.cv} download="Damien_Lo_CV.pdf">Download PDF</a>
      <span class="small muted">Last updated {profile.cvUpdated}</span>
    </p>
  </div>
  <div class="viewer-wrap">
    <object class="viewer" data={`${profile.links.cv}#view=FitH`} type="application/pdf" aria-label="CV of Damien Lo">
      <p class="wrap">Your browser can't show the PDF here. <a href={profile.links.cv}>Open the CV</a> instead.</p>
    </object>
  </div>
</Base>

<style>
  .page-title { margin-top: 2.5rem; }
  .row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .viewer-wrap { max-width: 920px; margin: 1rem auto 0; padding: 0 20px; }
  .viewer { width: 100%; height: 1150px; border: 1px solid var(--border); border-radius: 10px; background: #fff; }
  @media (max-width: 700px) {
    .viewer-wrap { display: none; }
  }
</style>
