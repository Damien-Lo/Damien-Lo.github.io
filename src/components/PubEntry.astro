---
import { ME, type Publication } from "../data/publications";

interface Props {
  pub: Publication;
  showSummary?: boolean;
}

const { pub, showSummary = true } = Astro.props;
const statusLabel: Record<string, string> = {
  "under-review": "Under review",
  accepted: "Accepted",
  published: "Published",
  thesis: "Thesis",
};
const hasEqual = (pub.equal?.length ?? 0) > 1;
---

<article class="pub">
  <h3 class="title">{pub.title}</h3>
  <p class="authors">
    {
      pub.authors.map((a, i) => (
        <>
          {a === ME ? <strong>{a}</strong> : a}
          {pub.equal?.includes(a) && <sup aria-label="equal contribution">*</sup>}
          {i < pub.authors.length - 1 ? ", " : ""}
        </>
      ))
    }
  </p>
  <p class="venue">
    <span class={`badge ${pub.status}`}>{statusLabel[pub.status]}</span>
    <span class="muted">{pub.venue}{pub.status === "thesis" ? `, ${pub.year}` : ""}</span>
  </p>
  {showSummary && <p class="summary">{pub.summary}</p>}
  {(pub.note || hasEqual) && (
    <p class="note small muted">
      {hasEqual && <span>* Equal contribution.</span>} {pub.note}
    </p>
  )}
  <div class="actions">
    {pub.links.paper && <a class="btn" href={pub.links.paper}>Paper</a>}
    {pub.links.code && <a class="btn" href={pub.links.code}>Code</a>}
    {pub.links.library && <a class="btn" href={pub.links.library}>Emory library</a>}
    {
      pub.bibtex && (
        <details class="bib">
          <summary class="btn">BibTeX</summary>
          <pre><code>{pub.bibtex}</code></pre>
        </details>
      )
    }
  </div>
</article>

<style>
  .pub { padding: 1.4rem 0; border-bottom: 1px solid var(--border); }
  .pub:last-child { border-bottom: 0; }
  .title { margin: 0 0 0.35rem; font-size: 1.12rem; }
  .authors { margin: 0 0 0.35rem; font-size: 0.95rem; }
  .authors sup { font-size: 0.7em; margin-left: 1px; }
  .venue { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 0.6rem; font-size: 0.92rem; }
  .summary { margin: 0 0 0.5rem; font-size: 0.97rem; }
  .note { margin: 0 0 0.6rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-start; }
  .actions:empty { display: none; }
  .bib[open] { width: 100%; }
  .bib summary { list-style: none; display: inline-flex; }
  .bib summary::-webkit-details-marker { display: none; }
  .bib pre { margin: 10px 0 0; padding: 12px 14px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; font-family: var(--mono); font-size: 0.78rem; line-height: 1.5; overflow-x: auto; white-space: pre; }
</style>
