---
import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name} | Machine learning privacy and model behavior`;
const desc =
  description ??
  "Damien Lo is a research assistant in the AIMS Lab at Emory University, working on privacy and memorization in vision large language models.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/", label: "Home" },
  { href: "/research", label: "Research" },
  { href: "/publications", label: "Publications" },
  { href: "/cv", label: "CV" },
  { href: "/about", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121418" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-nav">
      <div class="wrap bar">
        <a class="brand" href="/">{profile.name}</a>
        <nav aria-label="Main" class="desktop">
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}
        </nav>
        <details class="mobile">
          <summary aria-label="Menu">Menu</summary>
          <nav aria-label="Main mobile">
            {nav.map((n) => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="links small">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span aria-hidden="true">·</span>
          <a href={profile.links.github}>GitHub</a>
          <span aria-hidden="true">·</span>
          <a href={profile.links.linkedin}>LinkedIn</a>
          <span aria-hidden="true">·</span>
          <a href={profile.links.cv}>CV (PDF)</a>
        </p>
        <p class="small muted">© {new Date().getFullYear()} {profile.name}. Last updated {profile.siteUpdated}.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; background: var(--surface); padding: 6px 12px; border-radius: 6px; z-index: 20; }
  .skip:focus { left: 12px; }
  .site-nav { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: saturate(140%) blur(6px); border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { font-family: var(--serif); font-weight: 600; font-size: 1.1rem; color: var(--text); text-decoration: none; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.93rem; font-weight: 500; }
  nav a:hover, nav a[aria-current="page"] { color: var(--text); }
  nav a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 8px; }
  .desktop { display: flex; gap: 24px; }
  .mobile { display: none; position: relative; }
  .mobile summary { list-style: none; cursor: pointer; font-size: 0.93rem; font-weight: 500; padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile nav { position: absolute; right: 0; top: calc(100% + 8px); background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 8px; display: flex; flex-direction: column; min-width: 170px; box-shadow: 0 8px 24px rgb(0 0 0 / 0.08); }
  .mobile nav a { padding: 8px 12px; border-radius: 6px; }
  .mobile nav a[aria-current="page"] { text-decoration: none; background: var(--accent-soft); color: var(--accent); }
  @media (max-width: 640px) {
    .desktop { display: none; }
    .mobile { display: block; }
  }
  main { padding-bottom: 3rem; min-height: 70vh; }
  .site-footer { border-top: 1px solid var(--border); padding: 1.75rem 0 2.5rem; }
  .site-footer p { margin: 0 0 0.35rem; }
  .site-footer .links { display: flex; flex-wrap: wrap; gap: 6px 10px; }
</style>
